msgid "User:"
msgstr "Usuario:"

#: config.py:67
msgid "SSH &port:"
msgstr "&Puerto SSH:"

#: config.py:69
msgid "default SSH keys (~/.ssh)"
msgstr "claves SSH por defecto (~/.ssh)"

#: config.py:70
msgid "SSH &key file:"
msgstr "Archivo de &clave SSH:"

#: config.py:72
msgid "&KOReader folder:"
msgstr "Carpeta de &KOReader:"

#: config.py:74
msgid "&Book folders:"
msgstr "Carpetas de &libros:"

#: config.py:75
msgid "Sync automatically when the device connects to calibre"
msgstr "Sincronizar automáticamente cuando el dispositivo se conecta a calibre"

#: config.py:78
msgid "Show a summary after automatic syncs"
msgstr "Mostrar un resumen después de las sincronizaciones automáticas"

#: config.py:81
msgid "Also import from the KOReader Sync plugin column (for books that are not on the device)"
msgstr "Importar también desde la columna del plugin KOReader Sync (para libros que no están en el dispositivo)"

#: config.py:87
msgid "C&olumn:"
msgstr "C&olumna:"

#: config.py:89
msgid "Book data"
msgstr "Datos del libro"

#: config.py:90
msgid "(from KOReader to calibre; empty = do not sync). Values are only written when they change in KOReader, so what you edit by hand in calibre is kept."
msgstr "(de KOReader a calibre; vacío = no sincronizar). Solo se escriben cuando cambian en KOReader, así que lo que edites a mano en calibre se mantiene."

