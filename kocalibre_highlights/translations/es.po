#: action.py:38
msgid "Sync highlights between KOReader and the calibre viewer"
msgstr "Sincronizar highlights entre KOReader y el visor de calibre"

#: action.py:47
msgid "Sync all books"
msgstr "Sincronizar todos los libros"

#: action.py:49
msgid "Sync selected books"
msgstr "Sincronizar libros seleccionados"

#: action.py:51
msgid "Preview sync (change nothing)"
msgstr "Vista previa (no cambia nada)"

#: action.py:53
msgid "Import from the KOReader Sync column only"
msgstr "Importar solo desde la columna de KOReader Sync"

#: action.py:56
msgid "Open backups folder"
msgstr "Abrir carpeta de backups"

#: action.py:58
msgid "Configure"
msgstr "Configurar"

#: action.py:104
msgid "No books selected"
msgstr "No hay libros seleccionados"

#: action.py:104
msgid "Select the books to sync first"
msgstr "Seleccioná primero los libros a sincronizar"

#: action.py:116
msgid "Sync running"
msgstr "Sincronización en curso"

#: action.py:116
msgid "A highlights sync is already running"
msgstr "Ya hay una sincronización de highlights en curso"

#: action.py:125
msgid "No device"
msgstr "Sin dispositivo"

#: action.py:126
msgid "The address of the KOReader device is not known. Connect it to calibre wirelessly or set its address in the plugin settings."
msgstr "No se conoce la dirección del dispositivo con KOReader. Conectalo a calibre por wifi o configurá su dirección en el plugin."

#: action.py:132
msgid "Syncing KOReader highlights..."
msgstr "Sincronizando highlights de KOReader..."

#: action.py:138
msgid "Sync failed"
msgstr "Falló la sincronización"

#: action.py:138
msgid "The highlights sync failed"
msgstr "Falló la sincronización de highlights"

#: action.py:142
msgid "Preview only, nothing was changed."
msgstr "Vista previa: no se cambió nada."

#: config.py:50
msgid "Highlights are read and written over KOReader's SSH server (<i>Tools → More tools → SSH server</i>; enable login without password or add your public key). When the device is connected to calibre wirelessly, its address is detected automatically."
msgstr "Los highlights se leen y escriben por el servidor SSH de KOReader (<i>Herramientas → Más herramientas → Servidor SSH</i>; activá el inicio de sesión sin contraseña o agregá tu clave pública). Si el dispositivo está conectado a calibre por wifi, su dirección se detecta sola."

#: config.py:54
msgid "KOReader applies the changes the next time the book is opened on the device."
msgstr "KOReader aplica los cambios la próxima vez que abrís el libro en el dispositivo."

#: config.py:59
#, python-brace-format
msgid "automatic (last: {})"
msgstr "automática (última: {})"

#: config.py:59
msgid "none"
msgstr "ninguna"

#: config.py:60
msgid "Device &address:"
msgstr "&Dirección del dispositivo:"

